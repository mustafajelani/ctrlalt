# Postgres connection string. Works with Neon or any Postgres.
#   Neon (Vercel):  postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Local Postgres: postgresql://postgres:password@localhost:5432/ctrl_alt_del
DATABASE_URL=""

# Optional: Neon's direct (non-pooled) URL. Migrations use it when set.
# The Vercel + Neon integration adds this automatically.
DATABASE_URL_UNPOOLED=""

# Staff dashboard at /admin
ADMIN_PASSWORD="choose-a-long-passphrase"
# Random string, 32+ characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Public URL used for SEO metadata, sitemap and social cards
NEXT_PUBLIC_SITE_URL="https://www.ctrlaltdelllc.com"
